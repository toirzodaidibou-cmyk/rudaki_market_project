{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Cors": {
    "AdminOrigins": [
      "http://localhost:5173"
    ],
    "SiteOrigins": [
      "http://localhost:3123"
    ]
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Site": {
    "RevalidateUrl": "http://localhost:3123/api/revalidate"
  },
  "Auth": {
    "ExposeDevCode": true
  },
  "Sms": {
    "Provider": "Dev"
  }
}
